// ─────────────  FELLES RETTSKILDEBASE (minijuristen, AP-9)  ─────────────────
// Kun referanser og korte sammendrag i egne ord + kildehenvisning – aldri
// fulltekst (jf. Lovdata/opphavsrett). Deles på tvers av kunder.
model LegalSourceRef {
  id        String   @id @default(cuid())
  reference String   @unique   // "HR-2019-1225-A", "LH-2019-27272", "NS 8407 pkt. 5"
  court     String?            // "Høyesterett", "Eidsivating lagmannsrett", null for lov/standard
  decidedAt DateTime?
  topics    String[] @default([])  // ["plunder og heft","beviskrav","varsling"]
  summary   String             // kort referat i egne ord, maks ~1000 tegn
  sourceUrl String?            // hvor den ble funnet (lovdata.no, domstol.no, ...)
  addedBy   String   @default("MINIJURIST") // MINIJURIST | ADMIN
  verified  Boolean  @default(false)        // kvalitetssikret av menneske
  createdAt DateTime @default(now())

  @@index([topics])
}
