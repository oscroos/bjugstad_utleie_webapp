// ============================================================================
//  SCHEMA-TILLEGG DEL 4
//  - CO2-/miljøregnskap (utslippsfaktorer + beregningsgrunnlag)
//  - RUH/avvik og vernerunder (mater rapporteringen automatisk)
//  - Audit-logg (hvem gjorde hva når)
//  - AI-bruk / rate limiting
//  - App-synk (offline-først registrering fra felt-appen)
// ============================================================================


// ─────────────────────────  CO2 / MILJØREGNSKAP  ────────────────────────────

enum FuelType {
  DIESEL      // anleggsdiesel
  HVO         // HVO100 biodiesel
  ELECTRIC    // elektrisk (kWh)
  BIOGAS
  PETROL
  HYDROGEN
}

enum MachineOwnership {
  OWNED   // egen maskin
  RENTED  // leid maskin (fra utleiemodulen)
  SUBCONTRACTOR // UE sin maskin
}

// Utslippsfaktorer – felles referansedata (kg CO2e per enhet).
// Seedes med standardverdier (DFØ/Miljødirektoratet) og kan overstyres.
model EmissionFactor {
  id        String   @id @default(cuid())
  fuelType  FuelType @unique
  unit      String   // "liter" | "kWh" | "kg"
  kgCo2ePerUnit Float
  source    String?  // f.eks. "Miljødirektoratet 2025"
  validFrom DateTime @default(now())
}

// Én forbruksregistrering: en maskin brukte X enheter drivstoff/energi i en
// periode, på et prosjekt. Registreres manuelt, fra appen, eller avledes fra
// maskinmodulens driftstimer.
model FuelUsage {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  machineId   String?          // peker mot deres Machine-modell   // <-- EKSISTERENDE
  machineName String           // speilet for visning/historikk
  ownership   MachineOwnership @default(OWNED)

  // Hvis maskinen tilhører en UE:
  subcontractorOrgId String?

  fuelType  FuelType
  amount    Float    // antall enheter (liter/kWh)
  periodStart DateTime
  periodEnd   DateTime

  source    String  @default("MANUAL") // MANUAL | APP | MACHINE_MODULE
  appSyncId String? @unique            // idempotens ved app-synk

  createdById String
  createdAt   DateTime @default(now())

  @@index([projectId, periodStart])
  @@index([projectId, ownership])
}

// Utslipp fra massetransport kobles via MassMovement (del 3): transportKm +
