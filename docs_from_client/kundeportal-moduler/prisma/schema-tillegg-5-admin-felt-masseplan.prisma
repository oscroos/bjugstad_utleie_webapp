// ============================================================================
//  SCHEMA-TILLEGG DEL 5
//  - Admin-del: massetype-katalog + egendefinerte prosjektfelt (styres KUN av
//    portaladministrator, dvs. dere som leverandør)
//  - Utvidede faste prosjektfelt (kontraktstype, størrelse, byggherretype m.m.)
//  - Masseplan: planlagt volum/tonn INN og UT per massetype, valgt ved
//    prosjektoppstart. Registreringer får retning IN/OUT.
// ============================================================================


// ─────────────────────────  ADMIN: MASSETYPE-KATALOG  ───────────────────────

// Global katalog. KUN portaladmin (leverandør) kan endre. Kundene velger ved
// prosjektoppstart hvilke av disse som skal være valgbare i portal og app.
model MassTypeCatalog {
  id        String  @id @default(cuid())
  name      String  @unique          // "Jord", "Sprengstein", "Leire", "Asfaltflak"…
  unit      String  @default("m3")   // "m3" | "tonn"
  defaultClassification String @default("UNKNOWN") // CLEAN/CONTAMINATED/…
  tonnPerM3   Float @default(1.6)  // omregning volum↔vekt per materiale (del 8)
  swellFactor Float @default(1.0)  // løs vs. fast masse
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
}

// Massetyper valgt for et prosjekt (prosjektoppstart)
model ProjectMassType {
  id            String @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  massTypeId    String
  massType      MassTypeCatalog @relation(fields: [massTypeId], references: [id])

  // Planlagt mengde inn/ut av prosjektet (i katalogtypens enhet)
  plannedIn  Float @default(0)
  plannedOut Float @default(0)

  @@unique([projectId, massTypeId])
  @@index([projectId])
}

