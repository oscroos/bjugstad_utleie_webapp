// ───────────────  ADMIN: EGENDEFINERTE PROSJEKTFELT  ────────────────────────

enum FieldType { TEXT NUMBER DATE SELECT BOOLEAN }

// Feltdefinisjoner styres KUN av portaladmin. Vises på alle prosjekter.
model ProjectFieldDefinition {
  id        String    @id @default(cuid())
  label     String                      // "Rammeavtalenummer", "SHA-koordinator"…
  fieldType FieldType @default(TEXT)
  options   String[]  @default([])     // ved SELECT
  required  Boolean   @default(false)
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  values ProjectFieldValue[]
}

model ProjectFieldValue {
  id           String @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definitionId String
  definition   ProjectFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  @@unique([projectId, definitionId])
  @@index([projectId])
}


